{
  "files": [
    { "path": "package.json", "field": "version" },
    { "path": "plugin.json", "field": "version" },
    { "path": "gemini-extension.json", "field": "version" },
    { "path": "scripts/setup/package.json", "field": "version" }
  ],
  "versionTargets": [
    "./package.json",
    "./plugin.json",
    "./gemini-extension.json",
    "./scripts/setup/package.json"
  ],
  "audit": {
    "exclude": [
      "CHANGELOG.md",
      "RELEASE-NOTES.md",
      "node_modules",
      ".git",
      ".version-bump.json",
      "scripts/bump-version.sh"
    ]
  }
}
